// ======================================================================
// Firestore Security Rules
// نظام تحضير أعضاء هيئة التدريس - جامعة القصيم
//
// ملاحظة: النظام المُسلَّم يعمل افتراضيًا على Node.js/Express + SQLite
// (انظر مجلد backend). هذا الملف مُقدَّم كخيار بديل في حال رغبت مستقبلاً
// بترحيل قاعدة البيانات إلى Firebase Firestore. الافتراض هنا:
//
//   - يوجد custom claim باسم role على كل مستخدم مصادَق عبر Firebase Auth:
//     'admin' أو 'faculty' أو 'monitor'
//   - يوجد custom claim باسم department_id لمستخدمي monitor وfaculty
//   - المجموعات المقابلة لجداول SQL:
//     users, departments, courses, schedules, attendance, excuses,
//     semesters, universityLocation
// ======================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isFaculty() {
      return isSignedIn() && role() == 'faculty';
    }

    function isMonitor() {
      return isSignedIn() && role() == 'monitor';
    }

    // معرف المستخدم الحالي (يُفترض أن يكون uid = user document id)
    function uid() {
      return request.auth.uid;
    }

    function myDepartment() {
      return request.auth.token.department_id;
    }

    // ------------------------------------------------------------
    // Users: كل مستخدم يرى ملفه فقط. الـ Admin يرى الكل ويكتب.
    // مراقب القسم يرى فقط أعضاء قسمه (قراءة فقط).
    // ------------------------------------------------------------
    match /users/{userId} {
      allow read: if isAdmin()
                  || (isSignedIn() && uid() == userId)
                  || (isMonitor() && resource.data.department_id == myDepartment());
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------
    // Departments: قراءة عامة للمصادَقين، الكتابة للـ Admin فقط
    // ------------------------------------------------------------
    match /departments/{deptId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------
    // Semesters: قراءة عامة، الكتابة/التفعيل للـ Admin فقط
    // ------------------------------------------------------------
    match /semesters/{semId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------
    // Courses: قراءة عامة، الكتابة للـ Admin فقط
    // ------------------------------------------------------------
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------
    // Schedules: العضو يرى محاضراته فقط، المراقب يرى جداول قسمه،
    // الـ Admin يرى ويكتب كل شيء
    // ------------------------------------------------------------
    match /schedules/{scheduleId} {
      allow read: if isAdmin()
                  || (isFaculty() && resource.data.faculty_id == uid())
                  || (isMonitor() && resource.data.department_id == myDepartment());
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------
    // Attendance: أهم مجموعة أمنيًا
    //   - العضو (faculty) يقرأ سجلاته فقط، ويُنشئ/يُحدّث تسجيل حضوره
    //     الخاص به فقط، ولا يمكنه إنشاء سجل لعضو آخر أو تعديل حالة
    //     "حاضر" مباشرة بدون تحقق (التحقق الفعلي من GPS/الوقت يتم في
    //     Cloud Function وسيطة وليس مباشرة من العميل - راجع ملاحظة أدناه)
    //   - مراقب القسم يقرأ/يُحدّث سجلات قسمه فقط (صلاحية override)
    //   - الـ Admin يقرأ/يكتب كل شيء
    // ------------------------------------------------------------
    match /attendance/{attendanceId} {
      allow read: if isAdmin()
                  || (isFaculty() && resource.data.faculty_id == uid())
                  || (isMonitor() && resource.data.department_id == myDepartment());

      // العضو يُنشئ سجل حضور خاص به فقط، ولا يمكنه أبدًا كتابة status
      // مباشرة كـ 'present' من طرف العميل - يجب أن يمر ذلك عبر Cloud
      // Function موثوقة تتحقق من GPS/الوقت وتكتب هي بصلاحيات Admin SDK.
      allow create: if isFaculty()
                    && request.resource.data.faculty_id == uid()
                    && request.resource.data.status in ['absent', 'excused'];

      allow update: if isAdmin()
                    || (isMonitor() && resource.data.department_id == myDepartment());
    }

    // ------------------------------------------------------------
    // Excuses: العضو يُنشئ عذرًا لسجله فقط، الإدارة/المراقب يقرآن ويحدّثان
    // ------------------------------------------------------------
    match /excuses/{excuseId} {
      allow read: if isAdmin()
                  || (isFaculty() && resource.data.faculty_id == uid())
                  || (isMonitor() && resource.data.department_id == myDepartment());
      allow create: if isFaculty() && request.resource.data.faculty_id == uid();
      allow update: if isAdmin()
                    || (isMonitor() && resource.data.department_id == myDepartment());
    }

    // ------------------------------------------------------------
    // University Location: قراءة للمصادَقين (تلزم للتحقق الجغرافي عبر
    // Cloud Function)، الكتابة للـ Admin فقط. لا يجوز أبدًا السماح
    // بالكتابة من تطبيق العضو.
    // ------------------------------------------------------------
    match /universityLocation/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // أي مسار غير معرَّف صراحة أعلاه يُرفض افتراضيًا
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
